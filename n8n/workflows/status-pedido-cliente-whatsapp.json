      "position": [
        -60,
        -100
      ],
      "parameters": {
        "content": "### 1. Recebe o evento e busca o pedido\nBusca na `vw_pedidos` para ter nome do cliente, técnico e data atualizados.",
        "width": 740,
        "height": 820
      }
    },
