    {
      "id": "9487fc24-1fbb-53b6-a857-84dbdd104d08",
      "name": "É uma etapa avisada ao cliente?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        220,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "45029fbf-248c-5fcf-b639-9efabc1ae2d1",
              "leftValue": "={{ [\"aprovado\", \"agendado\", \"em_andamento\", \"concluido\"].includes($json.body.record.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "d57acba9-e0e1-5717-8b54-1c7e5288002f",
              "leftValue": "={{ $json.body.record.status }}",
              "rightValue": "={{ $json.body.old_record.status }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
